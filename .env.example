DATABASE_URL="postgresql://relay_app:change_me@localhost:5432/relay_whatsapp?schema=public"
WHATSAPP_VERIFY_TOKEN="create_your_own_random_value"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_APP_SECRET=""
META_APP_ID=""
# Facebook Login for Business configuration ID used by the optional SDK/Coexistence launcher.
META_EMBEDDED_SIGNUP_CONFIG_ID=""
# Copy from WhatsApp > Quickstart > View onboarding > Zero integration onboarding.
META_HOSTED_SIGNUP_URL=""
# Tech-provider system token used to fetch each customer's business token.
META_SYSTEM_TOKEN=""
# Used only by the backend to encrypt customer business tokens at rest.
# Use a stable random value of at least 32 characters. Changing it makes stored tokens unreadable.
META_TOKEN_ENCRYPTION_KEY=""
META_GRAPH_API_VERSION="v26.0"
# Native WhatsApp Flows (only needed for built-in live appointment booking)
WHATSAPP_FLOW_ENDPOINT_URL=""
WHATSAPP_FLOW_PRIVATE_KEY_FILE=""
